# Machine-specific paths. Copy this file to local.env (which is in .gitignore) and fill in your own values.
# Format: NAME=value, one per line, no quotes. Real environment variables of the same name take precedence.
# Every setting is optional.

# WSL path of the Windows copy that sync-windows.sh copies to and build.cmd builds in.
# ORCHARD_WINDOWS_DIR=/mnt/c/Users/<you>/Orchard

# GraalVM folder build.cmd uses on Windows (Windows path). If unset, build.cmd uses JAVA_HOME or looks in
# the usual install locations.
# ORCHARD_GRAALVM_HOME=C:\path\to\graalvm-jdk-21
